<script>

let policies = [

"Health Insurance",

"Vehicle Insurance",

"Home Insurance",

"Life Insurance"

];

function searchPolicy(){

let value =
document.getElementById("policySearch").value.toLowerCase();

let found =
policies.find(
policy => policy.toLowerCase().includes(value)
);

if(found){

document.getElementById("policyResult").innerHTML =
"<b>Policy Found:</b> " + found;

}
else{

document.getElementById("policyResult").innerHTML =
"<b>Policy Not Found</b>";

}

}

