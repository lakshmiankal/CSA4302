<!DOCTYPE html>
<html>
<head>
    <title>TechSavvy Online Shopping</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            background: #f2f2f2;
        }

        header {
            background: #673ab7;
            color: white;
            text-align: center;
            padding: 20px;
        }

        nav {
            background: #4527a0;
            padding: 12px;
            text-align: center;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 12px;
            font-weight: bold;
        }

        section {
            width: 85%;
            margin: 20px auto;
            background: white;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 0 5px gray;
        }

        input, select, textarea {
            width: 100%;
            padding: 10px;
            margin: 8px 0;
            box-sizing: border-box;
        }

        button {
            background: #673ab7;
            color: white;
            border: none;
            padding: 10px 20px;
            margin: 5px;
            cursor: pointer;
        }

        button:hover {
            background: #4527a0;
        }

        .products {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
        }

        .product {
            width: 220px;
            padding: 15px;
            border: 1px solid #ddd;
            border-radius: 8px;
            text-align: center;
        }

        .product img {
            width: 150px;
            height: 120px;
            object-fit: contain;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
        }

        table, th, td {
            border: 1px solid black;
        }

        th, td {
            padding: 10px;
            text-align: center;
        }

        footer {
            background: #673ab7;
            color: white;
            text-align: center;
            padding: 15px;
        }
    </style>
</head>

<body>

<header>
    <h1>TechSavvy Online Shopping</h1>
    <p>Latest Electronic Gadgets at Best Prices</p>
</header>

<nav>
    <a href="#home">Home</a>
    <a href="#login">Login</a>
    <a href="#products">Products</a>
    <a href="#cart">Cart</a>
    <a href="#orders">Orders</a>
    <a href="#wishlist">Wishlist</a>
    <a href="#admin">Admin</a>
</nav>

<!-- HOME -->

<section id="home">

    <h2>Welcome to TechSavvy</h2>

    <p>Shop smartphones, laptops, tablets and accessories online.</p>

    <h3>Categories</h3>

    <ul>
        <li>Smartphones</li>
        <li>Laptops</li>
        <li>Tablets</li>
        <li>Accessories</li>
    </ul>

    <h3>Subcategories</h3>

    <ul>
        <li>Android Phones</li>
        <li>iPhones</li>
        <li>Gaming Laptops</li>
        <li>Business Laptops</li>
        <li>Headphones</li>
        <li>Smart Watches</li>
    </ul>

</section>

<!-- REGISTER -->

<section>

    <h2>User Registration</h2>

    <input type="text" placeholder="Full Name">

    <input type="email" placeholder="Email">

    <input type="password" placeholder="Password">

    <button onclick="alert('Registration Successful')">
        Register
    </button>

</section>

<!-- LOGIN -->

<section id="login">

    <h2>User Login</h2>

    <input type="text" placeholder="Username">

    <input type="password" placeholder="Password">

    <button onclick="alert('Login Successful')">
        Login
    </button>

</section>

<!-- PRODUCTS -->

<section id="products">

    <h2>Search Products</h2>

    <input
        type="text"
        id="search"
        placeholder="Search product..."
    >

    <button onclick="searchProduct()">
        Search
    </button>

    <p id="searchResult"></p>

    <h2>Product Catalogue</h2>

    <div class="products">

        <div class="product">

            <h3>Smartphone</h3>

            <p>Android Smartphone</p>

            <p><b>₹25,000</b></p>

            <p>Available</p>

            <button onclick="addCart('Smartphone',25000)">
                Add to Cart
            </button>

            <button onclick="addWish('Smartphone')">
                Wishlist
            </button>

        </div>

        <div class="product">

            <h3>Laptop</h3>

            <p>Gaming Laptop</p>

            <p><b>₹60,000</b></p>

            <p>Available</p>

            <button onclick="addCart('Laptop',60000)">
                Add to Cart
            </button>

            <button onclick="addWish('Laptop')">
                Wishlist
            </button>

        </div>

        <div class="product">

            <h3>Tablet</h3>

            <p>10 inch Tablet</p>

            <p><b>₹20,000</b></p>

            <p>Available</p>

            <button onclick="addCart('Tablet',20000)">
                Add to Cart
            </button>

            <button onclick="addWish('Tablet')">
                Wishlist
            </button>

        </div>

        <div class="product">

            <h3>Headphones</h3>

            <p>Wireless Headphones</p>

            <p><b>₹3,000</b></p>

            <p>Available</p>

            <button onclick="addCart('Headphones',3000)">
                Add to Cart
            </button>

            <button onclick="addWish('Headphones')">
                Wishlist
            </button>

        </div>

    </div>

</section>

<!-- PRODUCT DETAILS -->

<section>

    <h2>Product Details</h2>

    <p><b>Product:</b> Smartphone</p>

    <p>
        Latest Android smartphone with high performance,
        excellent camera and long battery life.
    </p>

    <p><b>Price:</b> ₹25,000</p>

    <p><b>Availability:</b> In Stock</p>

    <h3>Customer Reviews</h3>

    <p>⭐⭐⭐⭐⭐ Excellent Product</p>

    <p>⭐⭐⭐⭐ Good performance</p>

</section>

<!-- CART -->

<section id="cart">

    <h2>Shopping Cart</h2>

    <p id="cartItems">
        Cart is empty.
    </p>

    <p id="total">
        Total: ₹0
    </p>

    <button onclick="editCart()">
        Edit Cart
    </button>

    <button onclick="removeCart()">
        Remove Item
    </button>

    <button onclick="checkout()">
        Checkout
    </button>

</section>

<!-- PAYMENT -->

<section>

    <h2>Payment</h2>

    <select>
        <option>Credit Card</option>
        <option>Debit Card</option>
        <option>UPI</option>
        <option>Net Banking</option>
    </select>

    <input
        type="text"
        placeholder="Payment Details"
    >

    <button onclick="alert('Payment Successful')">
        Pay Now
    </button>

</section>

<!-- SHIPPING -->

<section>

    <h2>Shipping Address</h2>

    <input
        type="text"
        placeholder="Name"
    >

    <input
        type="text"
        placeholder="Address"
    >

    <input
        type="text"
        placeholder="City"
    >

    <input
        type="text"
        placeholder="Pincode"
    >

    <button onclick="alert('Address Saved')">
        Save Address
    </button>

</section>

<!-- ORDERS -->

<section id="orders">

    <h2>My Orders</h2>

    <table>

        <tr>
            <th>Order ID</th>
            <th>Product</th>
            <th>Amount</th>
            <th>Status</th>
        </tr>

        <tr>
            <td>1001</td>
            <td>Smartphone</td>
            <td>₹25,000</td>
            <td>Shipped</td>
        </tr>

        <tr>
            <td>1002</td>
            <td>Headphones</td>
            <td>₹3,000</td>
            <td>Delivered</td>
        </tr>

    </table>

</section>

<!-- WISHLIST -->

<section id="wishlist">

    <h2>My Wishlist</h2>

    <p id="wishlistItems">
        Wishlist is empty.
    </p>

</section>

<!-- DISCOUNTS -->

<section>

    <h2>Special Offers</h2>

    <ul>
        <li>10% discount on smartphones</li>
        <li>15% discount on laptops</li>
        <li>20% discount on accessories</li>
    </ul>

</section>

<!-- ADMIN -->

<section id="admin">

    <h2>Admin Login</h2>

    <input
        type="text"
        placeholder="Admin Username"
    >

    <input
        type="password"
        placeholder="Admin Password"
    >

    <button onclick="alert('Admin Login Successful')">
        Login
    </button>

    <h2>Manage Products</h2>

    <input
        type="text"
        placeholder="Product Name"
    >

    <input
        type="number"
        placeholder="Product Price"
    >

    <textarea
        placeholder="Product Description"
    ></textarea>

    <input type="file">

    <button onclick="alert('Product Added')">
        Add Product
    </button>

    <button onclick="alert('Product Updated')">
        Update Product
    </button>

    <button onclick="alert('Product Deleted')">
        Delete Product
    </button>

    <h2>Customer Information</h2>

    <table>

        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Order</th>
        </tr>

        <tr>
            <td>Rahul</td>
            <td>rahul@gmail.com</td>
            <td>Smartphone</td>
        </tr>

        <tr>
            <td>Priya</td>
            <td>priya@gmail.com</td>
            <td>Laptop</td>
        </tr>

    </table>

</section>

<footer>

    <p>© 2026 TechSavvy Online Shopping</p>

</footer>

<script>

let cart = [];
let total = 0;
let wishlist = [];

function addCart(product, price) {

    cart.push(product);

    total = total + price;

    document.getElementById("cartItems").innerHTML =
        cart.join("<br>");

    document.getElementById("total").innerHTML =
        "Total: ₹" + total;

    alert(product + " added to cart");

}

function removeCart() {

    if(cart.length > 0) {

        cart.pop();

        document.getElementById("cartItems").innerHTML =
            cart.join("<br>");

        alert("Item removed");

    }
    else {

        alert("Cart is empty");

    }

}

function editCart() {

    alert("Cart editing option opened");

}

function checkout() {

    if(cart.length > 0) {

        alert("Checkout Successful");

    }
    else {

        alert("Please add products to cart");

    }

}

function addWish(product) {

    wishlist.push(product);

    document.getElementById("wishlistItems").innerHTML =
        wishlist.join("<br>");

    alert(product + " added to wishlist");

}

function searchProduct() {

    let value =
        document.getElementById("search").value.toLowerCase();

    let products = [
        "smartphone",
        "laptop",
        "tablet",
        "headphones"
    ];

    let found = products.find(
        product => product.includes(value)
    );

    if(found) {

        document.getElementById("searchResult").innerHTML =
            "<b>Product Found:</b> " + found;

    }
    else {

        document.getElementById("searchResult").innerHTML =
            "<b>Product Not Found</b>";

    }

}

</script>

</body>
</html>
