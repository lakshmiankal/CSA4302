<!DOCTYPE html>
<html>
<head>
<title>Online Flight Reservation System</title>

<style>
body{
font-family:Arial,sans-serif;
margin:0;
background:#f2f2f2;
}

header{
background:#0077cc;
color:white;
text-align:center;
padding:15px;
}

nav{
background:#005999;
padding:10px;
text-align:center;
}

nav a{
color:white;
text-decoration:none;
margin:15px;
font-weight:bold;
}

section{
width:80%;
margin:20px auto;
background:white;
padding:20px;
border-radius:8px;
box-shadow:0 0 5px gray;
}

input,select,textarea{
width:100%;
padding:10px;
margin:8px 0;
}

button{
background:#0077cc;
color:white;
padding:10px 20px;
border:none;
cursor:pointer;
}

button:hover{
background:#005999;
}

table{
width:100%;
border-collapse:collapse;
margin-top:10px;
}

table,th,td{
border:1px solid black;
}

th,td{
padding:10px;
text-align:center;
}

footer{
background:#0077cc;
color:white;
text-align:center;
padding:10px;
}
</style>

</head>

<body>

<header>
<h1>Online Flight Reservation System</h1>
</header>

<nav>
<a href="#home">Home</a>
<a href="#register">Register</a>
<a href="#login">Login</a>
<a href="#search">Search Flight</a>
<a href="#book">Book Ticket</a>
<a href="#payment">Payment</a>
<a href="#ticket">My Ticket</a>
<a href="#admin">Admin</a>
<a href="#feedback">Feedback</a>
</nav>

<section id="home">
<h2>Welcome</h2>
<p>Book domestic and international flights quickly and securely.</p>
</section>

<section id="register">
<h2>User Registration</h2>

<input type="text" placeholder="Full Name">

<input type="email" placeholder="Email">

<input type="password" placeholder="Password">

<button onclick="alert('Registration Successful')">Register</button>

</section>

<section id="login">
<h2>User Login</h2>

<input type="text" placeholder="Username">

<input type="password" placeholder="Password">

<button onclick="alert('Login Successful')">Login</button>

<h3>Forgot Password</h3>

<input type="email" placeholder="Enter Email">

<button onclick="alert('Password Reset Link Sent')">
Forgot Password
</button>

</section>

<section id="search">

<h2>Search Flight</h2>

<input type="text" id="flightSearch" placeholder="Enter Flight Name">

<button onclick="searchFlight()">Search</button>

<p id="result"></p>

<table>

<tr>
<th>Flight</th>
<th>Route</th>
<th>Time</th>
<th>Class</th>
<th>Seats</th>
</tr>

<tr>
<td>AI101</td>
<td>Chennai → Delhi</td>
<td>08:00 AM</td>
<td>Economy</td>
<td>25</td>
</tr>

<tr>
<td>6E220</td>
<td>Hyderabad → Mumbai</td>
<td>02:00 PM</td>
<td>Business</td>
<td>10</td>
</tr>

<tr>
<td>SG450</td>
<td>Bangalore → Kolkata</td>
<td>06:30 PM</td>
<td>Economy</td>
<td>18</td>
</tr>

</table>

</section>

<section id="book">

<h2>Book Ticket</h2>

<input type="text" placeholder="Passenger Name">

<input type="text" placeholder="From">

<input type="text" placeholder="To">

<input type="date">

<select>
<option>Economy</option>
<option>Business</option>
<option>First Class</option>
</select>

<input type="number" placeholder="Seat Number">

<button onclick="alert('Flight Ticket Booked Successfully')">
Book Ticket
</button>

</section>

<section id="payment">

<h2>Ticket Payment</h2>

<input type="text" placeholder="Card Number">

<input type="text" placeholder="Card Holder Name">

<button onclick="alert('Payment Successful')">
Pay Now
</button>

</section>

<section id="ticket">

<h2>My Ticket</h2>

<table>

<tr>
<th>Ticket No</th>
<th>Flight</th>
<th>Date</th>
<th>Status</th>
</tr>

<tr>
<td>FL12345</td>
<td>AI101</td>
<td>20-08-2026</td>
<td>Confirmed</td>
</tr>

</table>

<button onclick="alert('Booking Status : Confirmed')">
View Booking Status
</button>

<button onclick="alert('Ticket Printed')">
Print Ticket
</button>

<button onclick="alert('Ticket Cancelled')">
Cancel Ticket
</button>

</section>

<section id="feedback">

<h2>Customer Feedback</h2>

<textarea placeholder="Write Your Feedback"></textarea>

<button onclick="alert('Feedback Submitted')">
Submit
</button>

</section>

<section id="admin">

<h2>Administrator Login</h2>

<input type="text" placeholder="Admin Username">

<input type="password" placeholder="Password">

<button onclick="alert('Admin Login Successful')">
Login
</button>

<h2>Manage Flights</h2>

<input type="text" placeholder="Flight Number">

<input type="text" placeholder="Destination">

<input type="number" placeholder="Available Seats">

<input type="text" placeholder="Fare">

<button>Add / Update Flight</button>

<h2>Admin Report</h2>

<button onclick="alert('Report Generated Successfully')">
Generate Report
</button>

</section>

<footer>

<p>© 2026 Online Flight Reservation System</p>

</footer>

<script>

let flights=[
"AI101",
"6E220",
"SG450"
];

function searchFlight(){

let value=document.getElementById("flightSearch").value.toLowerCase();

let found=flights.find(flight=>flight.toLowerCase().includes(value));

if(found){
document.getElementById("result").innerHTML="<b>Flight Found:</b> "+found;
}
else{
document.getElementById("result").innerHTML="<b>Flight Not Found</b>";
}

}

</script>

</body>
</html>
