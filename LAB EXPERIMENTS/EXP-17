<button onclick="voterLogin()">

Login Using Voter ID

</button>

</section>


<!-- OTP LOGIN -->

<section id="otp">

<h2>OTP Login Verification</h2>

<input
type="text"
id="otpInput"
placeholder="Enter OTP"
>

<button onclick="sendLoginOTP()">

Get Login OTP

</button>

<button onclick="verifyOTP()">

Verify OTP

</button>

