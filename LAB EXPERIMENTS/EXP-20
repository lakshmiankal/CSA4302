<script>


let selectedVehicle="";
let selectedPrice=0;


function registerUser(){

alert("User Registered Successfully");

}


function loginUser(){

alert("User Login Successful");

}


function searchVehicle(){

let type=
document.getElementById("vehicleType").value;

let location=
document.getElementById("location").value;

document.getElementById("searchResult").innerHTML=
"<b>Search Completed!</b><br>"+
"Vehicle Type: "+type+
"<br>Location: "+location+
"<br>Available vehicles are displayed below.";

}


function selectVehicle(name,price){

selectedVehicle=name;

selectedPrice=price;

document.getElementById("selectedVehicle").value=name;

document.getElementById("vehiclePrice").value=price;

document.getElementById("booking").scrollIntoView();

}


function makeBooking(){

let name=
document.getElementById("customerName").value;

let customerNo=
document.getElementById("customerNo").value;

let address=
document.getElementById("customerAddress").value;

let vehicle=
document.getElementById("selectedVehicle").value;

if(name=="" ||
customerNo=="" ||
address=="" ||
vehicle==""){

alert(
"Please fill all booking details"
);

return;

}

document.getElementById("bookingMessage").innerHTML=
"<b>Booking Submitted Successfully!</b><br>"+
"Booking ID: RR1003<br>"+
"Vehicle: "+vehicle+
"<br>Status: Pending Approval";

}


</script>


