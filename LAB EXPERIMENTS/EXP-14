<!DOCTYPE html>
<html>

<head>

<title>ReNewMarket - Second Hand Marketplace</title>

<style>

body{
    font-family:Arial,sans-serif;
    margin:0;
    background:#f2f7f2;
}

header{
    background:#388e3c;
    color:white;
    text-align:center;
    padding:20px;
}

nav{
    background:#1b5e20;
    padding:12px;
    text-align:center;
}

nav a{
    color:white;
    text-decoration:none;
    margin:12px;
    font-weight:bold;
}

section{
    width:85%;
    margin:20px auto;
    background:white;
    padding:20px;
    border-radius:8px;
    box-shadow:0 0 5px gray;
}

input,select,textarea{
    width:100%;
    padding:10px;
    margin:8px 0;
    box-sizing:border-box;
}

button{
    background:#388e3c;
    color:white;
    border:none;
    padding:10px 20px;
    margin:5px;
    cursor:pointer;
}

button:hover{
    background:#1b5e20;
}

.items{
    display:flex;
    flex-wrap:wrap;
    gap:20px;
}

.item{
    width:220px;
    border:1px solid #ddd;
    padding:15px;
    border-radius:8px;
    text-align:center;
}

.item img{
    width:180px;
    height:150px;
    object-fit:cover;
}

table{
    width:100%;
    border-collapse:collapse;
    margin-top:10px;
}

table,th,td{
    border:1px solid black;
}

th,td{
    padding:10px;
    text-align:center;
}

footer{
    background:#388e3c;
    color:white;
    text-align:center;
    padding:15px;
}

</style>

</head>


