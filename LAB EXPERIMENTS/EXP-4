<!DOCTYPE html>
<html>
<head>
<title>Online Train Reservation System</title>

<style>
body{
font-family:Arial,sans-serif;
margin:0;
background:#f2f2f2;
}
header{
background:#0066cc;
color:white;
text-align:center;
padding:15px;
}
nav{
background:#004080;
padding:10px;
text-align:center;
}
nav a{
color:white;
text-decoration:none;
margin:15px;
font-weight:bold;
}
section{
background:white;
width:80%;
margin:20px auto;
padding:20px;
border-radius:8px;
box-shadow:0 0 5px gray;
}
input,select,textarea{
width:100%;
padding:10px;
margin:8px 0;
}
button{
background:#0066cc;
color:white;
border:none;
padding:10px 20px;
cursor:pointer;
}
button:hover{
background:#003366;
}
table{
width:100%;
border-collapse:collapse;
margin-top:10px;
}
table,th,td{
border:1px solid black;
}
th,td{
padding:10px;
text-align:center;
}
footer{
background:#0066cc;
color:white;
text-align:center;
padding:10px;
}
</style>

</head>

<body>

<header>
<h1>Online Train Reservation System</h1>
</header>

<nav>
<a href="#home">Home</a>
<a href="#register">Register</a>
<a href="#login">Login</a>
<a href="#search">Search Train</a>
<a href="#booking">Book Ticket</a>
<a href="#pnr">PNR Status</a>
<a href="#history">History</a>
<a href="#admin">Admin</a>
<a href="#contact">Contact</a>
</nav>

<section id="home">
<h2>Welcome</h2>
<p>Search trains, check seat availability, reserve tickets, check PNR status and cancel tickets.</p>
</section>

<section id="register">
<h2>User Registration</h2>
<input type="text" placeholder="Full Name">
<input type="email" placeholder="Email">
<input type="password" placeholder="Password">
<button onclick="alert('Registration Successful')">Register</button>
</section>

<section id="login">
<h2>User Login</h2>
<input type="text" placeholder="Username">
<input type="password" placeholder="Password">
<button onclick="alert('Login Successful')">Login</button>
</section>

<section id="search">
<h2>Search Train</h2>

<input type="text" id="searchTrain" placeholder="Enter Train Name">

<button onclick="searchTrain()">Search</button>

<p id="result"></p>

<table>
<tr>
<th>Train</th>
<th>Route</th>
<th>Time</th>
<th>Seats</th>
<th>Class</th>
</tr>

<tr>
<td>Express 101</td>
<td>Chennai - Bangalore</td>
<td>06:00 AM</td>
<td>120</td>
<td>Sleeper</td>
</tr>

<tr>
<td>Superfast 202</td>
<td>Hyderabad - Chennai</td>
<td>08:30 PM</td>
<td>80</td>
<td>AC 3 Tier</td>
</tr>

<tr>
<td>Mail 303</td>
<td>Bangalore - Mumbai</td>
<td>09:00 AM</td>
<td>60</td>
<td>AC 2 Tier</td>
</tr>

</table>

</section>

<section id="booking">

<h2>Book Ticket</h2>

<input type="text" placeholder="Passenger Name">

<input type="text" placeholder="Origin Station">

<input type="text" placeholder="Destination Station">

<input type="date">

<select>
<option>Sleeper</option>
<option>AC 3 Tier</option>
<option>AC 2 Tier</option>
<option>First Class</option>
</select>

<input type="number" placeholder="Seat Number">

<button onclick="alert('Ticket Booked Successfully\nPNR: 1234567890')">
Book Ticket
</button>

</section>

<section>

<h2>Payment</h2>

<select>
<option>Online</option>
<option>Offline</option>
</select>

<input type="text" placeholder="Card Number">

<input type="text" placeholder="Card Holder Name">

<button onclick="alert('Payment Successful')">
Pay Now
</button>

</section>

<section id="pnr">

<h2>Check PNR Status</h2>

<input type="text" placeholder="Enter PNR Number">

<button onclick="alert('PNR Status : Confirmed')">
Check Status
</button>

</section>

<section id="history">

<h2>Booking History</h2>

<table>

<tr>
<th>PNR</th>
<th>Train</th>
<th>Date</th>
<th>Status</th>
</tr>

<tr>
<td>1234567890</td>
<td>Express 101</td>
<td>15-08-2026</td>
<td>Confirmed</td>
</tr>

</table>

<button onclick="alert('Ticket Printed')">Print Ticket</button>

<button onclick="alert('Ticket Cancelled\nRefund Initiated')">Cancel Ticket</button>

</section>

<section>

<h2>Refund Information</h2>

<table>

<tr>
<th>Days Before Journey</th>
<th>Refund</th>
</tr>

<tr>
<td>More than 7 Days</td>
<td>90%</td>
</tr>

<tr>
<td>3 - 7 Days</td>
<td>50%</td>
</tr>

<tr>
<td>Less than 3 Days</td>
<td>25%</td>
</tr>

</table>

</section>

<section id="admin">

<h2>Admin Login</h2>

<input type="text" placeholder="Admin Username">

<input type="password" placeholder="Password">

<button onclick="alert('Admin Login Successful')">
Login
</button>

<h2>Train Management</h2>

<input type="text" placeholder="Train Name">

<input type="text" placeholder="Route">

<input type="number" placeholder="Available Seats">

<input type="text" placeholder="Fare">

<button>Add / Update Train</button>

<button onclick="alert('Train Details Updated')">
Save
</button>

</section>

<section id="contact">

<h2>Contact Us</h2>

<input type="text" placeholder="Name">

<input type="email" placeholder="Email">

<textarea placeholder="Message"></textarea>

<button onclick="alert('Message Sent Successfully')">
Send
</button>

</section>

<footer>
<p>© 2026 Online Train Reservation System</p>
</footer>

<script>

let trains=[
"Express 101",
"Superfast 202",
"Mail 303"
];

function searchTrain(){

let value=document.getElementById("searchTrain").value.toLowerCase();

let found=trains.find(train=>train.toLowerCase().includes(value));

if(found){
document.getElementById("result").innerHTML="<b>Train Found:</b> "+found;
}
else{
document.getElementById("result").innerHTML="<b>Train Not Found</b>";
}

}

</script>

</body>
</html>
