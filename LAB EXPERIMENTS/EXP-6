<!DOCTYPE html>
<html>
<head>
<title>Online Cake Ordering System</title>

<style>
body{
font-family:Arial,sans-serif;
margin:0;
background:#f2f2f2;
}
header{
background:#ff4081;
color:white;
text-align:center;
padding:15px;
}
nav{
background:#d81b60;
padding:10px;
text-align:center;
}
nav a{
color:white;
text-decoration:none;
margin:15px;
font-weight:bold;
}
section{
width:80%;
margin:20px auto;
background:white;
padding:20px;
border-radius:8px;
box-shadow:0 0 5px gray;
}
input,select,textarea{
width:100%;
padding:10px;
margin:8px 0;
}
button{
background:#ff4081;
color:white;
border:none;
padding:10px 20px;
cursor:pointer;
}
button:hover{
background:#d81b60;
}
table{
width:100%;
border-collapse:collapse;
margin-top:10px;
}
table,th,td{
border:1px solid black;
}
th,td{
padding:10px;
text-align:center;
}
footer{
background:#ff4081;
color:white;
text-align:center;
padding:10px;
}
</style>

</head>

<body>

<header>
<h1>Online Cake Ordering System</h1>
</header>

<nav>
<a href="#home">Home</a>
<a href="#register">Register</a>
<a href="#login">Login</a>
<a href="#cakes">Cakes</a>
<a href="#cart">Cart</a>
<a href="#orders">Orders</a>
<a href="#admin">Admin</a>
<a href="#contact">Contact</a>
</nav>

<section id="home">
<h2>Welcome</h2>
<p>Order delicious cakes online for birthdays, weddings and special occasions.</p>
</section>

<section id="register">
<h2>Student Registration</h2>
<input type="text" placeholder="Full Name">
<input type="email" placeholder="Email">
<input type="password" placeholder="Password">
<button onclick="alert('Registered Successfully')">Register</button>
</section>

<section id="login">
<h2>Student Login</h2>
<input type="text" placeholder="Username">
<input type="password" placeholder="Password">
<button onclick="alert('Login Successful')">Login</button>
</section>

<section id="cakes">
<h2>Search Cake</h2>

<input type="text" id="searchCake" placeholder="Search Cake">

<button onclick="searchCake()">Search</button>

<p id="result"></p>

<h3>Filter</h3>

<select>
<option>Birthday</option>
<option>Wedding</option>
<option>Anniversary</option>
<option>Chocolate</option>
<option>Vanilla</option>
</select>

<select>
<option>₹0 - ₹500</option>
<option>₹500 - ₹1000</option>
<option>Above ₹1000</option>
</select>

<table>

<tr>
<th>Cake</th>
<th>Category</th>
<th>Price</th>
<th>Status</th>
</tr>

<tr>
<td>Chocolate Cake</td>
<td>Birthday</td>
<td>₹500</td>
<td>Available</td>
</tr>

<tr>
<td>Black Forest</td>
<td>Wedding</td>
<td>₹800</td>
<td>Available</td>
</tr>

<tr>
<td>Red Velvet</td>
<td>Anniversary</td>
<td>₹1000</td>
<td>Available</td>
</tr>

</table>

<h3>Cake Description</h3>

<p>Fresh cakes prepared with premium ingredients and custom decorations.</p>

<button onclick="alert('Cake Added to Cart')">
Add to Cart
</button>

</section>

<section id="cart">

<h2>Place Order</h2>

<input type="text" placeholder="Shipping Address">

<textarea placeholder="Special Message on Cake"></textarea>

<select>
<option>Half Kg</option>
<option>1 Kg</option>
<option>2 Kg</option>
</select>

<button onclick="alert('Order Placed Successfully')">
Place Order
</button>

</section>

<section>

<h2>Payment</h2>

<input type="text" placeholder="Card Number">

<input type="text" placeholder="Card Holder Name">

<button onclick="alert('Payment Successful')">
Pay Now
</button>

</section>

<section id="orders">

<h2>My Orders</h2>

<table>

<tr>
<th>Order ID</th>
<th>Cake</th>
<th>Status</th>
</tr>

<tr>
<td>101</td>
<td>Chocolate Cake</td>
<td>Shipped</td>
</tr>

</table>

<button onclick="alert('Shipping Status : Out for Delivery')">
View Shipping Status
</button>

</section>

<section id="admin">

<h2>Admin Login</h2>

<input type="text" placeholder="Admin Username">

<input type="password" placeholder="Password">

<button onclick="alert('Admin Login Successful')">
Login
</button>

<h2>Manage Products</h2>

<input type="text" placeholder="Cake Name">

<input type="text" placeholder="Category">

<input type="text" placeholder="Description">

<input type="number" placeholder="Price">

<input type="file">

<button>Post Cake Details</button>

<h2>Manage Orders</h2>

<button onclick="alert('Order Status Updated')">
Update Order Status
</button>

<input type="text" placeholder="Shipping Location">

<button>Logout</button>

</section>

<section id="contact">

<h2>Contact Us</h2>

<input type="text" placeholder="Name">

<input type="email" placeholder="Email">

<textarea placeholder="Message"></textarea>

<button onclick="alert('Message Sent Successfully')">
Send
</button>

</section>

<footer>

<p>© 2026 Online Cake Ordering System</p>

</footer>

<script>

let cakes=[
"Chocolate Cake",
"Black Forest",
"Red Velvet",
"Vanilla Cake"
];

function searchCake(){

let value=document.getElementById("searchCake").value.toLowerCase();

let found=cakes.find(cake=>cake.toLowerCase().includes(value));

if(found){
document.getElementById("result").innerHTML="<b>Cake Found:</b> "+found;
}
else{
document.getElementById("result").innerHTML="<b>Cake Not Found</b>";
}

}

</script>

</body>
</html>
