<td>priya@gmail.com</td>
</tr>

</table>

</section>

<footer>
<p>© 2026 Home Finder Real Estate Portal</p>
</footer>

<script>

let locations=[
"chennai",
"hyderabad",
"bangalore"
];

function searchProperty(){

let value=document.getElementById("searchBox")
.value.toLowerCase();

let found=locations.find(
location=>location.includes(value)
);

if(found){
document.getElementById("result").innerHTML=
"<b>Properties Available in:</b> "+found;
}
else{
document.getElementById("result").innerHTML=
"<b>No Property Found</b>";
}

}

</script>

</body>
</html>
