<script>


function subscribeDoctor(){

let clinic=
document.getElementById("clinic").value;

if(clinic=="govt"){

document.getElementById("subscription").innerHTML=
"<b>Government CVH Subscription Successful - Free</b>";

}

else{

document.getElementById("subscription").innerHTML=
"<b>Private Doctor Subscription Fee: ₹500</b>";

}

}


function postComplaint(){

let animal=
document.getElementById("animal").value;

let symptoms=
document.getElementById("symptoms").value;

if(animal=="" || symptoms==""){

alert(
"Please enter animal name and symptoms"
);

return;

}

document.getElementById("complaintMessage").innerHTML=
"<b>Complaint Submitted Successfully!</b><br>"+
"Complaint ID: VC1003";

}


function makePayment(){

let fee=
document.getElementById("fee").value;

if(fee>0){

document.getElementById("paymentMessage").innerHTML=
"<b>Payment Successful!</b><br>"+
"Amount Paid: ₹"+fee;

}

else{

alert("Enter a valid payment amount");

}

}


function generateReport(){

document.getElementById("reportMessage").innerHTML=
"<b>Disease Report Generated Successfully.</b>";

}

</script>


