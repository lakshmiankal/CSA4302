<footer>

<p>© 2026 Library Management System</p>

</footer>

<script>

let books=[
"Java Programming",
"Python Basics",
"HTML & CSS",
"Database Management",
"Data Structures"
];

function searchBook(){

let value=document.getElementById("search").value.toLowerCase();

let found=books.find(book=>book.toLowerCase().includes(value));

if(found){
document.getElementById("result").innerHTML="<b>Book Found:</b> "+found;
}
else{
document.getElementById("result").innerHTML="<b>Book Not Found</b>";
}

}

</script>

</body>
</html>
