<!DOCTYPE html>
<html>

<head>

<title>VoteOnline - E-Voting System</title>

<style>

body{
    font-family:Arial,sans-serif;
    margin:0;
    background:#f4f6f8;
}

header{
    background:#1565c0;
    color:white;
    text-align:center;
    padding:20px;
}

nav{
    background:#0d47a1;
    padding:12px;
    text-align:center;
}

nav a{
    color:white;
    text-decoration:none;
    margin:12px;
    font-weight:bold;
}

section{
    width:85%;
    margin:20px auto;
    background:white;
    padding:20px;
    border-radius:8px;
    box-shadow:0 0 5px gray;
}

input,select,textarea{
    width:100%;
    padding:10px;
    margin:8px 0;
    box-sizing:border-box;
}

button{
    background:#1565c0;
    color:white;
    border:none;
    padding:10px 20px;
    margin:5px;
    cursor:pointer;
}

button:hover{
    background:#0d47a1;
}

.candidate{
    border:1px solid #ddd;
    padding:15px;
    margin:10px 0;
    border-radius:8px;
}

.candidate img{
    width:80px;
    height:80px;
    border-radius:50%;
}

.result{
    background:#e3f2fd;
    padding:15px;
    margin:10px 0;
    border-radius:6px;
}

table{
    width:100%;
    border-collapse:collapse;
    margin-top:10px;
}

table,th,td{
    border:1px solid black;
}

th,td{
    padding:10px;
    text-align:center;
}

footer{
    background:#1565c0;
    color:white;
    text-align:center;
    padding:15px;
}

</style>

</head>


<body>


<header>

<h1>🗳️ VoteOnline</h1>

<p>Secure Online Voting System</p>

</header>


<nav>

<a href="#home">Home</a>

<a href="#login">Voter Login</a>

<a href="#otp">OTP</a>

<a href="#vote">Vote</a>

<a href="#history">History</a>

<a href="#admin">Admin</a>

<a href="#results">Results</a>

</nav>


<!-- HOME -->

<section id="home">

<h2>Welcome to VoteOnline</h2>

<p>
VoteOnline provides a simple and secure platform
for voters to participate in elections.
</p>

<h3>Election Information</h3>

