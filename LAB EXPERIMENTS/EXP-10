    padding:15px;
    text-align:center;
    border-radius:8px;
}

.product img{
    width:180px;
    height:180px;
    object-fit:cover;
}

table{
    width:100%;
    border-collapse:collapse;
    margin-top:10px;
}

table,th,td{
    border:1px solid black;
}

th,td{
    padding:10px;
    text-align:center;
}

footer{
    background:#222;
    color:white;
    text-align:center;
    padding:15px;
}

