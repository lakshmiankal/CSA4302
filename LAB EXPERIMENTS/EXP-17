<script>


let loginOTP="123456";

let votingOTP="654321";

let voteSubmitted=false;


function voterLogin(){

let id=
document.getElementById("voterId").value;

if(id!=""){

alert(
"Voter Login Successful\n"+
"OTP has been sent to your registered mobile number."
);

}

else{

alert("Please enter Voter ID");

}

}


function sendLoginOTP(){

document.getElementById("otpMessage").innerHTML=
"Demo OTP sent: <b>123456</b>";

}


function verifyOTP(){

let otp=
document.getElementById("otpInput").value;

if(otp==loginOTP){

document.getElementById("otpMessage").innerHTML=
"<b>OTP Verified Successfully</b>";

}

else{

document.getElementById("otpMessage").innerHTML=
"<b>Invalid OTP</b>";

}

}


function getVotingOTP(){

document.getElementById("votingOTP").innerHTML=
"Demo Voting OTP: <b>654321</b>";

}


function submitVote(){

if(voteSubmitted){

alert("You have already submitted your vote.");

return;

}


let candidate=
document.querySelector(
'input[name="candidate"]:checked'
);


if(!candidate){

alert("Please select a candidate.");

return;

}


let otp=prompt(
"Enter Voting OTP\nDemo OTP: 654321"
);


if(otp!="654321"){

alert("Invalid Voting OTP.");

return;

}


voteSubmitted=true;


document.getElementById("voteMessage").innerHTML=
"<b>Vote submitted successfully!</b>";


document.getElementById("confirmation").innerHTML=
"<b>Vote Confirmed</b><br>"+
"Candidate: "+candidate.value+
"<br>Election: Local Ward Election 2026"+
"<br>Voter ID: VOT1001";


alert(
"Your vote has been submitted successfully."
);

}


function getResults(){

document.getElementById("resultMessage").innerHTML=
"<b>Election Results Generated Successfully.</b>";

}

</script>


</body>

</html>
